#--....|......--        |.|
# |.......|...|   ------|.|
# |....|..|...| --|.....|.|
# |....---|...| |.+.....|.|
# |.......|..-- |-|.....|.|
# ----....|.--  |.+.....+.|
#    ---.--.|   |-|.....|--
#     |.....|   |.+.....|  
#     |..|..|   --|.....|  
#     -------     -------  
#ENDMAP
